# ============================================================
#  chester-bi  —  Environment Configuration
# ============================================================
#
#  SETUP INSTRUCTIONS
#  ------------------
#  1. Copy this file and rename the copy to ".env"
#        cp .example.env .env          (Linux / macOS)
#        copy .example.env .env        (Windows CMD)
#
#  2. Fill in every value marked  ← REQUIRED
#     The optional sections can be left commented out until
#     you actually need them.
#
#  3. Never commit your real .env to version control.
#     It is already listed in .gitignore.
#
# ============================================================


# ------------------------------------------------------------
#  AUTHENTICATION  (JWT)
# ------------------------------------------------------------

# Secret key used to sign JWT access tokens.
# Generate a strong random string — at least 32 characters.
#
#   Quick way to generate one:
#     Python : python -c "import secrets; print(secrets.token_hex(32))"
#     Node   : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#     OpenSSL: openssl rand -hex 32
#
SECRET_KEY="REPLACE_WITH_A_LONG_RANDOM_STRING"   # ← REQUIRED

# JWT signing algorithm — HS256 is fine for most deployments.
# Only change this if you have a specific reason (e.g. RS256 for asymmetric keys).
ALGORITHM="HS256"

# How many minutes a login session stays valid before the user must log in again.
# Default: 180 minutes (3 hours).  Increase for less friction, decrease for tighter security.
ACCESS_TOKEN_EXPIRE_MINUTES=180


# ------------------------------------------------------------
#  ENCRYPTION  (Fernet — stored database credentials)
# ------------------------------------------------------------

# Used to encrypt database passwords that chester-bi stores internally.
# Must be a valid Fernet key (URL-safe base64, 32 bytes before encoding).
#
#   Generate one:
#     Python: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Example output looks like: "IsQmOS1nzaCHIaYqYL-8IgCU9HYUL9uDUFZNCdlVi9Q="
#
FERNET_KEY="REPLACE_WITH_FERNET_KEY"   # ← REQUIRED


# ------------------------------------------------------------
#  FILE STORAGE  (choose ONE of the two options below)
# ------------------------------------------------------------

# ── Option A: Local disk (default, easiest for development) ──
#
# Files are stored in this folder on the machine running the backend.
# The Malloy Publisher Docker container is also mounted to this path
# (see the "publisher" service in docker-compose.yml).
# Leave this as-is unless you move the project folder.
#
LOCAL_DIR="./.local/"

# ── Option B: AWS S3 (recommended for production / multi-instance) ──
#
# If ALL THREE AWS variables are set, the app automatically switches
# to S3 storage and ignores LOCAL_DIR entirely.
# Comment them out (or delete them) to fall back to local storage.
#
# AWS_STORAGE_BUCKET_NAME="your-s3-bucket-name"
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="AKIAxxxxxxxxxxxxxxxx"
# AWS_SECRET_ACCESS_KEY="your-secret-access-key"


# ------------------------------------------------------------
#  MALLOY PUBLISHER  (query engine)
# ------------------------------------------------------------

# The Malloy Publisher service runs as a Docker container (see docker-compose.yml).
# It listens on port 4000.
#
# If you are running the backend INSIDE Docker:
#   Use "host.docker.internal" so the container can reach the host.
#   (On Linux you may need to add  extra_hosts: ["host.docker.internal:host-gateway"]
#    to the backend service in docker-compose.yml)
#
# If you are running the backend DIRECTLY on your machine (e.g. `uvicorn` in a terminal):
#   Use "localhost" or "127.0.0.1"
#
MALLOY_HOST="host.docker.internal"   # ← change to "localhost" if running backend outside Docker
MALLOY_PORT="4000"


# ------------------------------------------------------------
#  REDIS  (query-result cache)
# ------------------------------------------------------------

# Redis is used to cache Malloy query results and avoid re-running
# expensive queries on every page load.
#
# The docker-compose.yml does NOT spin up Redis — you must run it separately:
#
#   Docker (quickest):
#     docker run -d -p 6379:6379 redis:7-alpine
#
#   Or install Redis locally:
#     https://redis.io/docs/getting-started/installation/
#
# Same host rules as MALLOY_HOST above apply:
#   Inside Docker  → "host.docker.internal"
#   Outside Docker → "localhost"
#
REDIS_HOST="host.docker.internal"   # ← change to "localhost" if running backend outside Docker
REDIS_PORT="6379"

# How long (in seconds) a cached query result is kept before Redis evicts it.
# Default: 1800 seconds (30 minutes).
# Set lower (e.g. 60) during development so stale results expire quickly.
REDIS_CACHE_TTL=1800
