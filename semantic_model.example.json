{
    "name" : "ecommerce_revenue_analytics",
    "description" : "Core semantic model for analyzing store revenue, order counts, and customer demographics.",
    "display_name" : "E-Commerce Revenue & Customer Analysis",
    "main_table" : "sales_transactions",
    "joins" :{
        "customer_profiles" : {
            "on" : "sales_transactions.customer_id = customer_profiles.id",
            "type" : "inner",
            "conditions" : [
                {
                    "column" : "customer_profiles.email",
                    "operator" : "not like",
                    "value" : "%@companytest.com"
                }
            ]
        }
    },

    "tables" : {
        "sales_transactions" : {
            "columns" : {
                "transaction_id" : {
                    "type" : "dimension",
                    "name" : "transaction_id",
                    "description" : "The unique identifier for each completed customer order.",
                    "display_name" : "Order ID",
                    "data_type" : "integer",
                },
                "order_status" : {
                    "type" : "dimension",
                    "name" : "order_status",
                    "description" : "Current state of the order (e.g., Shipped, Pending, Cancelled).",
                    "display_name" : "Order Status",
                    "data_type" : "string",
                    "sql" : "status"
                },
                "purchase_time" : {
                    "type" : "dimension",
                    "name" : "purchase_time",
                    "description" : "The timestamp when the transaction checkout was completed.",
                    "display_name" : "Purchase Date/Time",
                    "data_type" : "timestamp",
                    "sql" : "created_at"
                },
                "total_order_amount" : {
                    "type" : "metric",
                    "description" : "Total gross revenue generated from sales before discounts.",
                    "display_name" : "Total Revenue (USD)",
                    "data_type" : "double",
                    "sql" : "sum(order_amount)"
                },
                "total_order_count" : {
                    "type" : "metric",
                    "description" : "The total count of distinct valid orders processed.",
                    "display_name" : "Total Orders",
                    "data_type" : "integer",
                    "sql" : "count(id)"
                }
            }
        },
        "customer_profiles" : {
            "columns" : {
                "customer_country" : {
                    "type" : "dimension",
                    "description" : "The registration country country of the purchasing customer.",
                    "display_name" : "Customer Country",
                    "data_type" : "string",
                    "sql" : "country_code"
                },
                "is_premium_member" : {
                    "type" : "dimension",
                    "description" : "Flag indicating if the user belongs to the active loyalty tier.",
                    "display_name" : "Is Loyalty Member",
                    "data_type" : "boolean",
                    "sql" : "is_active_loyalty_user"
                },
                "unique_customer_count" : {
                    "type" : "metric",
                    "description" : "The distinct count of buyers who purchased an item.",
                    "display_name" : "Unique Buyers Count",
                    "data_type" : "integer",
                    "sql" : "count(distinct id)"
                }
            }
        }
    }
}
